{
  "identifier": "stateforge.ui/input.field@1",
  "purpose": "Schema-compatible scalar control.",
  "applicable_surfaces": [
    "stateforge.ui/surface.operation.request@1",
    "stateforge.ui/surface.trigger.policy@1"
  ],
  "properties_schema": {
    "type": "object",
    "properties": {
      "label": {
        "type": "string",
        "maxLength": 160
      },
      "description": {
        "type": "string",
        "maxLength": 500
      },
      "placeholder": {
        "type": "string",
        "maxLength": 160
      },
      "widget": {
        "type": "string",
        "enum": [
          "auto",
          "text",
          "textarea",
          "number",
          "checkbox",
          "select",
          "radio",
          "slider",
          "date-time"
        ]
      }
    },
    "additionalProperties": false
  },
  "binding_slots": [
    {
      "name": "field_schema",
      "data_shape": "JSON Schema object",
      "sources": [
        "operation.input_schema@1",
        "trigger.declaration@1"
      ]
    }
  ],
  "asset_slots": [],
  "children": {
    "allowed": false,
    "maximum_per_node": 0,
    "allowed_component_identifiers": "none"
  },
  "fallback_guidance": {
    "provider_may_supply": true,
    "fallback_must_use_core_catalog": true,
    "recommended_core_components": []
  },
  "example": {
    "properties": {
      "widget": "auto"
    },
    "bindings": {
      "field_schema": {
        "source_identifier": "operation.input_schema@1",
        "pointer": "/properties/name"
      }
    }
  }
}
