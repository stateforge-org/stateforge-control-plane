        "evidence.record@1"
      ]
    },
    {
      "name": "after",
      "data_shape": "JSON value",
      "sources": [
        "operation.result@1",
        "evidence.record@1"
      ]
    }
  ],
  "asset_slots": [],
  "children": {
    "allowed": false,
    "maximum_per_node": 0,
    "allowed_component_identifiers": "none"
  },
  "fallback_guidance": {
    "provider_may_supply": true,
    "fallback_must_use_core_catalog": true,
    "recommended_core_components": []
  },
  "example": {
    "properties": {
      "beforeLabel": "Before",
      "afterLabel": "After",
      "format": "json"
    },
    "bindings": {
      "before": {
        "source_identifier": "operation.result@1",
        "pointer": "/before"
      },
      "after": {
        "source_identifier": "operation.result@1",
        "pointer": "/after"
      }
    }
