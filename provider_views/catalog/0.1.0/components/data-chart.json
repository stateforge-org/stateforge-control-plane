{
  "identifier": "stateforge.ui/data.chart@1",
  "purpose": "Line, area, bar, or scatter series.",
  "applicable_surfaces": [
    "stateforge.ui/surface.provider.overview@1",
    "stateforge.ui/surface.operation.run@1",
    "stateforge.ui/surface.operation.result@1",
    "stateforge.ui/surface.trigger.event@1",
    "stateforge.ui/surface.evidence@1"
  ],
  "properties_schema": {
    "type": "object",
    "properties": {
      "kind": {
        "type": "string",
        "enum": [
          "line",
          "area",
          "bar",
          "scatter"
        ]
      },
      "xLabel": {
        "type": "string",
        "maxLength": 80
      },
      "yLabel": {
        "type": "string",
        "maxLength": 80
      }
    },
    "additionalProperties": false
  },
  "binding_slots": [
    {
      "name": "series",
      "data_shape": "array of series or points",
      "sources": [
        "provider.statistics@1",
        "operation.run@1",
        "operation.result@1",
        "trigger.event@1",
        "evidence.record@1"
      ]
    }
  ],
  "asset_slots": [],
  "children": {
    "allowed": false,
    "maximum_per_node": 0,
    "allowed_component_identifiers": "none"
  },
  "fallback_guidance": {
    "provider_may_supply": true,
    "fallback_must_use_core_catalog": true,
    "recommended_core_components": [
      "stateforge.ui/data.table@1"
    ]
  },
  "example": {
    "properties": {
      "kind": "line",
      "xLabel": "Time",
      "yLabel": "Value"
    },
    "bindings": {
      "series": {
        "source_identifier": "provider.statistics@1",
        "pointer": "/series"
      }
    }
  }
}
