{
  "identifier": "stateforge.ui/status.badge@1",
  "purpose": "Compact semantic state.",
  "applicable_surfaces": [
    "stateforge.ui/surface.provider.overview@1",
    "stateforge.ui/surface.operation.run@1",
    "stateforge.ui/surface.operation.result@1",
    "stateforge.ui/surface.trigger.event@1",
    "stateforge.ui/surface.evidence@1"
  ],
  "properties_schema": {
    "type": "object",
    "properties": {
      "label": {
        "type": "string",
        "maxLength": 100
      },
      "tone": {
        "type": "string",
        "enum": [
          "neutral",
          "info",
          "success",
          "warning",
          "danger"
        ]
      }
    },
    "additionalProperties": false
  },
  "binding_slots": [
    {
      "name": "state",
      "data_shape": "string or object",
      "sources": [
        "provider.health@1",
        "operation.run@1",
        "operation.result@1",
        "trigger.event@1",
        "evidence.record@1"
      ]
    }
  ],
  "asset_slots": [],
  "children": {
    "allowed": false,
    "maximum_per_node": 0,
    "allowed_component_identifiers": "none"
  },
  "fallback_guidance": {
    "provider_may_supply": true,
    "fallback_must_use_core_catalog": true,
    "recommended_core_components": []
  },
  "example": {
    "properties": {
      "label": "Ready",
      "tone": "success"
    },
    "bindings": {
      "state": {
        "source_identifier": "provider.health@1",
        "pointer": ""
      }
    }
  }
}
