{
  "identifier": "stateforge.ui/data.log@1",
  "catalog_status": "proposed",
  "purpose": "Bounded streaming or retained log output.",
  "applicable_surfaces": [
    "stateforge.ui/surface.operation.run@1",
    "stateforge.ui/surface.operation.result@1",
    "stateforge.ui/surface.trigger.event@1",
    "stateforge.ui/surface.evidence@1"
  ],
  "properties_schema": {
    "type": "object",
    "properties": {
      "maxLines": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5000
      },
      "autoFollow": {
        "type": "boolean"
      }
    },
    "additionalProperties": false
  },
  "binding_slots": [
    {
      "name": "entries",
      "data_shape": "string or array of log records",
      "sources": [
        "operation.run@1",
        "operation.result@1",
        "trigger.event@1",
        "evidence.record@1"
      ]
    }
  ],
  "asset_slots": [],
  "children": {
    "allowed": false,
    "maximum_per_node": 0,
    "allowed_component_identifiers": "none"
  },
  "fallback_guidance": {
    "provider_may_supply": true,
    "fallback_must_use_core_catalog": true,
    "recommended_core_components": []
  },
  "example": {
    "properties": {
      "maxLines": 200,
      "autoFollow": false
    },
    "bindings": {
      "entries": {
        "source_identifier": "operation.run@1",
        "pointer": "/logs"
      }
    }
  }
}
